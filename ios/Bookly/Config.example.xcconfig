// App config. Copy to ios/Bookly/Config.xcconfig (git-ignored), then replace the YOUR_..._HERE values.
// URL and anon key only: never a service role or Anthropic key.
// Cloud: both values are in the Supabase dashboard → Project Settings → API Keys.
// Local stack instead: SUPABASE_URL = http:/$()/127.0.0.1:54321 and the anon key from `supabase status`.
// xcconfig treats "//" as a comment, so the scheme is written as https:/$()/ — the empty $() keeps both slashes.
SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY_HERE
