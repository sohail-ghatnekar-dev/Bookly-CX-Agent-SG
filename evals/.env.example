# Copy to evals/.env.remote (cloud) or evals/.env (local). Never commit the copy.
# Cloud values: Project Settings → API Keys. Local values: `supabase status -o env`.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Eval runner only. Never put this in the app, the function, or any tracked file.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
