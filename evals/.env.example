# Eval runner keys. Copy to evals/.env.remote (cloud) or evals/.env (local), then replace the YOUR_..._HERE values.
# Both copies are git-ignored. Never commit them.
# Cloud values: Supabase dashboard → Project Settings → API Keys. Local values: `supabase status -o env`.

# Your project URL. Locally it's http://127.0.0.1:54321.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# The public anon key, the same one the app uses.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# The service role key. The eval runner only. Never put this in the app, the function, or any tracked file.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
