# Bookly agent secrets. Copy to supabase/.env.hosted (cloud) or supabase/.env (local), then replace the YOUR_..._HERE values.
# Both copies are git-ignored. Never commit them.

# Your Claude API key, from console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# The Claude model the agent calls. Leave as is unless you want a different one.
ANTHROPIC_MODEL=claude-haiku-5-5

# Keep false in the cloud. Set true only in a local supabase/.env, where the evals load a bad test procedure on purpose.
ALLOW_REDTEAM=false
