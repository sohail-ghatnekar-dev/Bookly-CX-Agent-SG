# Copy to supabase/.env.hosted (cloud) or supabase/.env (local). Never commit the copies.
# Get a key at console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5
# "false" in the cloud. "true" only locally, where the evals load a bad test procedure.
ALLOW_REDTEAM=true
